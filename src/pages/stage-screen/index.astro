---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Stage Screen"
  description="Stage Screen is an iPhone and iPad countdown timer that puts the timer on an external display while the controls stay in your hands. Support and privacy information."
>
  <h2>Stage Screen</h2>
  <p>
    Stage Screen is a countdown timer for iPhone and iPad. Plug the device into a
    projector, TV or monitor and the external display shows only the timer; your own
    screen keeps the controls.
  </p>
  <h3>Support</h3>
  <p>
    Questions, bugs, ideas: email{" "}
    <a href="mailto:stagescreen@bence.dev">stagescreen@bence.dev</a>.
  </p>
  <h3>Privacy</h3>
  <p>
    The app has no accounts and sends only anonymous usage statistics. The full{" "}
    <a href="/stage-screen/privacy">privacy policy</a> says exactly what and where.
  </p>
</Layout>
